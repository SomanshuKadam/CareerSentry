# Server-only Bright Data credentials. Never expose these with NEXT_PUBLIC_.
BRIGHT_DATA_API_TOKEN=replace_with_your_server_only_token

# The protected one-input RevRag route is disabled unless this and the token
# above are configured server-side. Never expose this with NEXT_PUBLIC_.
CAREERSENTRY_RUN_KEY=replace_with_a_long_server_only_run_key

# Provider-neutral PostgreSQL connection used by Drizzle. The collection route
# fails closed before triggering Bright Data when durable storage is absent.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Server-only owned healing fixture switch. Omit or use "a" for the safe
# baseline; use "b" only for an explicitly controlled demo deployment.
CAREERSENTRY_FIXTURE_LAYOUT=a

# Add only after a target passes the policy, provenance, and Marketplace gates.
BRIGHT_DATA_DISCOVERY_COLLECTOR_ID=c_replace_after_approval
BRIGHT_DATA_PDP_COLLECTOR_ID=c_replace_after_approval
