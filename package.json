{
  "name": "career-sentry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo:live:baseline": "node scripts/demo-live-run.mjs baseline",
    "demo:live:layout-b": "npx -y vercel --prod --yes --force --scope somanshu3 --env CAREERSENTRY_FIXTURE_LAYOUT=b",
    "demo:live:failure": "node scripts/demo-live-run.mjs failure",
    "demo:live:codex": "node scripts/codex-healing-proposal.mjs --force --input artifacts/brightdata-healing/demo-layout-b-codex-input.json --output artifacts/codex-healing/demo-layout-b-proposal.json",
    "demo:live:heal": "node scripts/brightdata-heal-live.mjs --proposal artifacts/codex-healing/demo-layout-b-proposal.json --output artifacts/brightdata-healing/demo-layout-b-heal-progress.json",
    "demo:live:review": "node scripts/review-live-heal.mjs",
    "demo:live:approve": "npx -y -p @brightdata/cli bdata scraper approve c_mt5mfwuv2910ltr23s --auto-save --url https://career-sentry.vercel.app/demo-target/live --pretty",
    "demo:live:verify": "node scripts/demo-live-run.mjs verify",
    "demo:live:restore": "npx -y vercel --prod --yes --force --scope somanshu3 --env CAREERSENTRY_FIXTURE_LAYOUT=a",
    "brightdata:heal:live": "node scripts/brightdata-heal-live.mjs",
    "healing:codex": "node scripts/codex-healing-proposal.mjs",
    "db:generate": "drizzle-kit generate --config=src/lib/persistence/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=src/lib/persistence/drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.468.0",
    "next": "^14.2.31",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.7",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
